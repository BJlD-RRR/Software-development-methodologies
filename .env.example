# Шаблон змінних середовища. Скопіюйте у .env і змініть паролі:
#   cp .env.example .env
# Файл .env не потрапляє в git (правило *.env у .gitignore).

# PostgreSQL
POSTGRES_DB=warehouse
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change_me

# Web API
API_PORT=8080
# Development вмикає Swagger UI (/swagger)
ASPNETCORE_ENVIRONMENT=Development

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
